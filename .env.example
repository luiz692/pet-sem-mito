# Endereço do banco Postgres (Neon). Na Vercel ele é preenchido sozinho ao conectar o Neon.
# Sem essa variável, o site usa um banco local na pasta .banco-local (só para desenvolvimento).
DATABASE_URL=

# Opcional: endereço público do site, usado no QR code do telão.
# Se ficar vazio, o QR code usa o endereço em que o telão foi aberto.
NEXT_PUBLIC_SITE_URL=
